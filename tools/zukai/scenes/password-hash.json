{
  "meta": {
    "title": "パスワードハッシュとは？ソルトだけでは守れない理由を60秒で",
    "intro": "パスワードをハッシュで保存していても、漏れると破られることがある理由を図解で。",
    "hashtags": "#テック朝刊 #パスワード #セキュリティ #エンジニア",
    "kaisetsu": {"kind": "解説", "title": "パスワードハッシュとは？ソルトと「わざと遅い」計算が必要な理由を1つの漏えいの例で", "minutes": 4}
  },
  "nodes": {
    "db":    {"type": "code", "x": 540, "y": 700, "w": 900, "lines": ["users テーブル", "taro  sha1:5baa61e4…", "hana  sha1:7c4a8d09…"]},
    "leak":  {"type": "chip", "x": 900, "y": 528, "text": "流出", "color": "red"},
    "ca":    {"type": "chip", "x": 260, "y": 900, "text": "password", "color": "yellow"},
    "cb":    {"type": "chip", "x": 540, "y": 900, "text": "123456", "color": "yellow"},
    "cc":    {"type": "chip", "x": 820, "y": 900, "text": "qwerty", "color": "yellow"},
    "hash":  {"type": "box", "x": 540, "y": 1060, "w": 320, "h": 130, "label": "SHA-1", "sub": "一方向の変換"},
    "res":   {"type": "chip", "x": 540, "y": 1200, "text": "5baa61e4…", "color": "yellow"},
    "c1":    {"type": "counter", "x": 540, "y": 1340, "suffix": "億回/秒", "caption": "GPU1枚で試せる数", "color": "white"},
    "b1":    {"type": "bar", "x": 100, "y": 1340, "label": "SHA-1", "text": "約500億回/秒", "color": "red"},
    "b2":    {"type": "bar", "x": 100, "y": 1470, "label": "bcrypt（コスト5）", "text": "約3万回/秒", "color": "blue"}
  },
  "steps": [
    {
      "headline": "ハッシュなのに\nなぜ破られる？",
      "narration": "パスワードはハッシュにして保存してある。それでも漏れると破られるのは、なぜ？",
      "mike": "detective",
      "keys": [
        {"dur": 0, "show": ["db", "leak", "b1", "b2"], "set": {"b1": {"w": 600}, "b2": {"w": 4}}}
      ]
    },
    {
      "headline": "会員DBが流出した",
      "narration": "ある会員サイトのデータベースが流出しました。中身はエスエイチエーワンのハッシュです。",
      "mike": "talk",
      "keys": [
        {"dur": 0.3, "hide": ["b1", "b2"]},
        {"at": 0.35, "dur": 0, "set": {"b1": {"w": 0}, "b2": {"w": 0}}},
        {"at": 0.6, "dur": 0.25, "set": {"leak": {"scale": 1.25}}},
        {"at": 0.85, "dur": 0.25, "set": {"leak": {"scale": 1}}},
        {"at": 1.6, "dur": 0.3, "set": {"db": {"hl": 1}}}
      ]
    },
    {
      "headline": "ハッシュは元に戻せない",
      "narration": "ハッシュは一方向の変換で、この文字列から元のパスワードには戻せません。",
      "mike": "talk",
      "keys": [
        {"at": 0.2, "dur": 0.4, "show": ["hash"]},
        {"at": 1.2, "dur": 0.3, "set": {"hash": {"color": "blue"}}}
      ]
    },
    {
      "headline": "なら候補を全部試す",
      "narration": "そこで攻撃者は、よくあるパスワードを片っ端からハッシュにして、同じ答えを探します。",
      "mike": "detective",
      "keys": [
        {"dur": 0.3, "set": {"hash": {"color": "gray"}}},
        {"at": 0.3, "dur": 0.3, "show": ["ca"]},
        {"at": 0.6, "dur": 0.3, "show": ["cb"]},
        {"at": 0.9, "dur": 0.3, "show": ["cc"]},
        {"at": 1.6, "dur": 0.7, "set": {"ca": {"x": 540, "y": 1060}, "cb": {"dim": 0.6}, "cc": {"dim": 0.6}}},
        {"at": 2.3, "dur": 0.2, "hide": ["ca"], "set": {"hash": {"color": "yellow"}}},
        {"at": 2.5, "dur": 0.4, "show": ["res"], "set": {"hash": {"color": "gray"}}}
      ]
    },
    {
      "headline": "一致したら正体がわかる",
      "narration": "答えが一致すれば、元はパスワードという文字列だとわかります。",
      "mike": "talk",
      "keys": [
        {"at": 0.3, "dur": 0.3, "set": {"res": {"color": "green", "text": "5baa61e4… 一致"}, "db": {"hl": 1}}},
        {"at": 0.6, "dur": 0.25, "set": {"res": {"scale": 1.15}}},
        {"at": 0.85, "dur": 0.25, "set": {"res": {"scale": 1}}}
      ]
    },
    {
      "headline": "GPU1枚で毎秒500億回",
      "narration": "しかもエスエイチエーワンは速い。ジーピーユー1枚で、1秒に約500億回も試せます。",
      "mike": "talk",
      "keys": [
        {"dur": 0.3, "show": ["c1"], "set": {"cb": {"dim": 0.8}, "cc": {"dim": 0.8}}},
        {"at": 0.3, "dur": 2.4, "ease": "linear", "set": {"c1": {"value": 500}}},
        {"at": 2.7, "dur": 0.3, "set": {"c1": {"color": "red"}}}
      ]
    },
    {
      "headline": "ソルトで同じ答えを防ぐ",
      "narration": "ソルトを混ぜると、同じパスワードでも答えがばらばらになり、作り置きの対応表が使えません。",
      "mike": "talk",
      "keys": [
        {"dur": 0.3, "hide": ["ca", "cb", "cc", "res"], "set": {"db": {"hl": -1}}},
        {"at": 0.5, "dur": 0, "set": {"db": {"lines": ["users テーブル", "taro  salt=x9f2  sha1:e1c0…", "hana  salt=k3d8  sha1:94ab…"]}}},
        {"at": 0.5, "dur": 0.4, "set": {"db": {"hl": 1}}},
        {"at": 1.6, "dur": 0.4, "set": {"db": {"hl": 2}}}
      ]
    },
    {
      "headline": "でも総当たりは速いまま",
      "narration": "でも、1件ずつ総当たりする速さは、ソルトがあっても変わりません。",
      "mike": "detective",
      "keys": [
        {"dur": 0.3, "set": {"db": {"hl": -1, "dim": 0.5}}},
        {"at": 0.6, "dur": 0.25, "set": {"c1": {"scale": 1.15}}},
        {"at": 0.85, "dur": 0.25, "set": {"c1": {"scale": 1}}}
      ]
    },
    {
      "headline": "わざと遅いハッシュにする",
      "narration": "そこで、ビークリプトのような、わざと遅いハッシュを使います。",
      "mike": "talk",
      "keys": [
        {"dur": 0.3, "hide": ["c1"]},
        {"at": 0.4, "dur": 0.2, "set": {"hash": {"scale": 0.9}}},
        {"at": 0.6, "dur": 0, "set": {"hash": {"label": "bcrypt", "sub": "わざと遅い"}}},
        {"at": 0.6, "dur": 0.4, "set": {"hash": {"scale": 1, "color": "blue"}}}
      ]
    },
    {
      "headline": "1秒に約3万回まで落ちる",
      "narration": "同じジーピーユーでも、1秒に約3万回。500億回と比べると、けた違いに遅くなります。",
      "mike": "talk",
      "keys": [
        {"dur": 0.3, "show": ["b1", "b2"]},
        {"at": 0.3, "dur": 0.8, "set": {"b1": {"w": 600}}},
        {"at": 1.3, "dur": 0.8, "set": {"b2": {"w": 4}}},
        {"at": 2.4, "dur": 0.3, "set": {"b2": {"scale": 1.1}}},
        {"at": 2.7, "dur": 0.3, "set": {"b2": {"scale": 1}}}
      ]
    },
    {
      "headline": "続きは\n4分の解説で",
      "narration": "くわしくは4分の解説動画で。テック朝刊は毎朝6時に、エンジニア向けのニュースと解説を届けています。チャンネル登録をして、チェックしてください。",
      "mike": "talk",
      "cta": true
    }
  ]
}
